---
import "../styles/global.css";
import CommonHead from "../components/CommonHead.astro";
import GameSwitch from "../components/GameSwitch.astro";
import Icon from "../components/Icon.astro";
import Email from "../components/Email.astro";
import { DISCORD } from "../data/contact";

export type Section = "tf2" | "cryptic" | "discord" | "home";

interface Props {
  game: Section;
  title?: string;
  description?: string;
  image?: string;
}

const { game, title, description, image } = Astro.props;
const onContact = Astro.url.pathname.replace(/\/$/, "") === "/contact";
---

<!doctype html>
<!-- Pages swap without an animation of their own: only the header's switch
     slides, and the backdrop's glow fades to the new colour. -->
<html lang="en" data-game={game} transition:animate="none">
  <head>
    <CommonHead title={title} description={description} image={image} />
  </head>
  <body>
    <!-- Kept across page changes, so its glow can fade from one colour to the next. -->
    <div class="backdrop" transition:persist="backdrop"></div>

    <header class="site-header">
      <div class="container">
        <a class="brand" href="/">
          <span class="brand-mark"><img src="/favicon.png" alt="" width="28" height="28" /></span>
          <span class="brand-name">modworks</span>
        </a>
        <GameSwitch game={game} />
        <nav class="nav" aria-label="Site">
          <a href="/contact" aria-current={onContact ? "page" : undefined}>Contact</a>
        </nav>
        <div class="header-actions">
          <a class="btn btn-ghost btn-sm btn-collapse" href={DISCORD} target="_blank" rel="noopener" aria-label="Discord">
            <Icon name="chat" /><span class="btn-label">Discord</span>
          </a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <span>© {new Date().getFullYear()} modworks.tf · made by iMicro</span>
        <nav aria-label="Footer">
          <a href="/contact">Contact</a>
          <a href="https://github.com/WhyiMicro" target="_blank" rel="noopener">GitHub</a>
          <a href={DISCORD} target="_blank" rel="noopener">Discord</a>
          <Email />
        </nav>
      </div>
    </footer>
  </body>
</html>
