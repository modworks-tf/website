---
import Icon from "./Icon.astro";
import type { Section } from "../layouts/Base.astro";

/**
 * TF2 | Minecraft | Discord, in the header of every page. Kept across page
 * changes (transition:persist), so the pill slides from one to the other as
 * the page swaps instead of jumping.
 */
interface Props {
  game: Section;
}

const { game } = Astro.props;
const active = game === "home" ? "none" : game;
const links = [
  { id: "tf2", href: "/tf2", label: "TF2", icon: "target" },
  { id: "cryptic", href: "/cryptic", label: "Minecraft", icon: "cube" },
  { id: "discord", href: "/discord", label: "Discord", icon: "chat" },
] as const;
---

<nav class="game-switch" data-active={active} aria-label="Choose a section" transition:persist="game-switch">
  <span class="indicator" aria-hidden="true"></span>
  {
    links.map((link) => (
      <a href={link.href} data-game-link={link.id} aria-current={game === link.id ? "page" : undefined}>
        <Icon name={link.icon} />
        <span>{link.label}</span>
      </a>
    ))
  }
</nav>

<script>
  // The switch is the old page's element after a swap, so it is told where it
  // is now from the new page's <html data-game>. Changing data-active is what
  // slides the indicator across.
  function sync() {
    const game = document.documentElement.dataset.game ?? "home";
    const sw = document.querySelector<HTMLElement>(".game-switch");
    if (!sw) return;
    sw.dataset.active = game === "home" ? "none" : game;
    sw.querySelectorAll<HTMLAnchorElement>("[data-game-link]").forEach((link) => {
      if (link.dataset.gameLink === game) link.setAttribute("aria-current", "page");
      else link.removeAttribute("aria-current");
    });
  }
  document.addEventListener("astro:after-swap", sync);
  document.addEventListener("astro:page-load", sync);
</script>
