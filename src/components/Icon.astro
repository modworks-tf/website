---
/**
 * Line icons drawn on a 24-pixel grid, inline so nothing extra is loaded.
 * Props: name, and an optional size (defaults to the CSS size of its parent).
 */
interface Props {
  name: keyof typeof paths;
  size?: number;
  label?: string;
}

const paths = {
  cube: `<path d="M12 2.8 20.5 7.4v9.2L12 21.2 3.5 16.6V7.4Z"/><path d="M3.5 7.4 12 12l8.5-4.6M12 12v9.2"/>`,
  target: `<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="3"/><path d="M12 1.5v4M12 18.5v4M1.5 12h4M18.5 12h4"/>`,
  download: `<path d="M12 3.5v11"/><path d="m7.5 10 4.5 4.5 4.5-4.5"/><path d="M4 16.5v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/>`,
  arrowRight: `<path d="M4.5 12h15M13.5 6l6 6-6 6"/>`,
  external: `<path d="M14 4.5h5.5V10M19.5 4.5 11 13"/><path d="M18 14v4.5a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 4 18.5v-11A1.5 1.5 0 0 1 5.5 6H10"/>`,
  chevronDown: `<path d="m6 9 6 6 6-6"/>`,
  code: `<path d="m8.5 7-5 5 5 5M15.5 7l5 5-5 5"/>`,
  chat: `<path d="M20.5 12a8 8 0 0 1-11.8 7l-4.7 1.5 1.5-4.4A8 8 0 1 1 20.5 12Z"/>`,
  mail: `<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/>`,
  skull: `<path d="M12 3a8 8 0 0 0-5 14.2V20h10v-2.8A8 8 0 0 0 12 3Z"/><circle cx="9" cy="11.5" r="1.6"/><circle cx="15" cy="11.5" r="1.6"/><path d="M10 20v-2M14 20v-2"/>`,
  crown: `<path d="m3 7.5 4.5 4 4.5-6.5 4.5 6.5 4.5-4-2 11H5Z"/><path d="M5 18.5h14"/>`,
  gem: `<path d="M6.5 3.5h11l4 5.5-9.5 11.5L2.5 9Z"/><path d="M2.5 9h19M12 20.5 8.5 9l3.5-5.5L15.5 9Z"/>`,
  sparkles: `<path d="M12 3.5 13.8 9l5.7 1.9-5.7 1.9L12 18.5l-1.8-5.7-5.7-1.9L10.2 9Z"/><path d="M19 3v3M17.5 4.5h3M5 17.5v3M3.5 19h3"/>`,
  eye: `<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/>`,
  sliders: `<path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0"/><circle cx="16" cy="6" r="2"/><circle cx="10" cy="12" r="2"/><circle cx="18" cy="18" r="2"/>`,
  bell: `<path d="M6 16.5V11a6 6 0 0 1 12 0v5.5l1.5 2h-15Z"/><path d="M10 21h4"/>`,
  gift: `<rect x="3.5" y="8" width="17" height="4" rx="1"/><path d="M5 12v8.5h14V12M12 8v12.5"/><path d="M12 8C10 4 7 4.5 7 6.3 7 8 12 8 12 8Zm0 0c2-4 5-3.5 5-1.7C17 8 12 8 12 8Z"/>`,
  refresh: `<path d="M20 11.5A8 8 0 0 0 5.6 6.4L4 8M4 3.5V8h4.5"/><path d="M4 12.5a8 8 0 0 0 14.4 5.1L20 16M20 20.5V16h-4.5"/>`,
  layers: `<path d="m12 3 9 5-9 5-9-5Z"/><path d="m3 12.5 9 5 9-5M3 17l9 5 9-5"/>`,
  check: `<path d="m4.5 12.5 4.5 4.5 10.5-10.5"/>`,
  package: `<path d="M3.5 7.5 12 3l8.5 4.5v9L12 21l-8.5-4.5Z"/><path d="m3.5 7.5 8.5 4.5 8.5-4.5M12 12v9M7.8 5.2l8.5 4.6"/>`,
  copy: `<rect x="8" y="8" width="12.5" height="12.5" rx="2"/><path d="M16 8V5.5A2 2 0 0 0 14 3.5H5.5a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2H8"/>`,
  wrench: `<path d="M14.5 6.5a4 4 0 0 0 5.2 5.2l-8.4 8.4a2.1 2.1 0 0 1-3-3l8.4-8.4"/><path d="M14.5 6.5 17.5 3.5a4 4 0 0 1 3 3l-3 3"/>`,
};

const { name, size, label } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  set:html={paths[name]}
/>
