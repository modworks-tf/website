---
/**
 * Refreshes every Cryptic download link on the page from GitHub in the
 * browser, so a release made after the last deploy is still what people get.
 * Links carry data-latest-download; text that names the version carries
 * data-latest-version, data-latest-size or data-latest-date.
 */
import { REPO } from "../lib/releases";
---

<script define:vars={{ repo: REPO }}>
  async function refresh() {
    const links = document.querySelectorAll("[data-latest-download]");
    if (!links.length) return;
    try {
      const response = await fetch(`https://api.github.com/repos/${repo}/releases/latest`, {
        headers: { Accept: "application/vnd.github+json" },
      });
      if (!response.ok) return;
      const release = await response.json();
      const jar = (release.assets ?? []).find((a) => a.name.endsWith(".jar") && !a.name.includes("sources"));
      if (!jar) return;
      const version = (/^v?(\d+\.\d+\.\d+)/.exec(release.tag_name) ?? [])[1] ?? release.tag_name;
      links.forEach((link) => (link.href = jar.browser_download_url));
      document.querySelectorAll("[data-latest-version]").forEach((el) => (el.textContent = version));
      document
        .querySelectorAll("[data-latest-size]")
        .forEach((el) => (el.textContent = `${(jar.size / 1024 / 1024).toFixed(1)} MB`));
      document
        .querySelectorAll("[data-latest-date]")
        .forEach(
          (el) =>
            (el.textContent = new Date(release.published_at).toLocaleDateString("en-GB", {
              day: "numeric",
              month: "short",
              year: "numeric",
            })),
        );
    } catch {
      // Offline, or rate limited: the build's links stay, which is fine.
    }
  }
  // An inline script runs again each time its page is swapped in, so it simply
  // refreshes now rather than adding a listener per visit.
  refresh();
</script>
