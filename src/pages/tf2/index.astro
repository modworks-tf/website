---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { mods } from "../../data/tf2";
---

<Base
  game="tf2"
  title="TF2 mods · modworks.tf"
  description="A hand-picked set of Team Fortress 2 mods and tools: HUDs, crosshairs, textures, viewmodels and more.">
  <section class="hero hero-plain">
    <div class="container">
      <div>
        <span class="eyebrow">Team Fortress 2</span>
        <h1>Mods worth installing, <span class="soft">all in one place.</span></h1>
        <p class="lede">
          A short, hand-picked list of TF2 mods and tools: a custom UI, crosshairs, cleaner textures and viewmodels. Each
          one downloads straight from its creator.
        </p>
      </div>
    </div>
  </section>

  <section class="container store">
    <div class="grid grid-3">
      {
        mods.map((mod) => (
          <article class="card mod">
            <div class="mod-top">
              <span class="mod-initial" aria-hidden="true">
                {mod.name.charAt(0).toUpperCase()}
              </span>
              <div class="mod-tags">
                {mod.tags?.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </div>
            <h3>{mod.name}</h3>
            <p>{mod.description}</p>
            <div class="mod-meta">
              <span>by {mod.creator}</span>
              <span>{mod.version}</span>
            </div>
            <a class="btn btn-primary btn-sm mod-action" href={mod.href} download rel="noopener">
              <Icon name="download" />
              Download
            </a>
          </article>
        ))
      }
    </div>
  </section>
</Base>

<script>
  // Links from the old site pointed at tabs: #Contact now has its own page,
  // and #Other held tools that moved to the Discord page.
  function followOldLinks() {
    const hash = location.hash.toLowerCase();
    if (hash === "#contact") location.replace("/contact");
    else if (hash === "#other") location.replace("/discord");
  }
  document.addEventListener("astro:page-load", () => {
    if (location.pathname.startsWith("/tf2")) followOldLinks();
  });
</script>

<style>
  .store {
    position: relative;
    z-index: 1;
    padding-bottom: 96px;
  }
</style>
