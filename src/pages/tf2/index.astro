---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Modal from "../../components/Modal.astro";
import { mods, others, contacts } from "../../data/tf2";

const tabs = [
  { id: "mods", label: "Mods", count: mods.length },
  { id: "other", label: "Other tools", count: others.length },
  { id: "contact", label: "Contact", count: contacts.length },
];
---

<Base
  game="tf2"
  title="TF2 mods · modworks.tf"
  description="A hand-picked set of Team Fortress 2 mods and tools: HUDs, crosshairs, textures, viewmodels and more."
  nav={[
    { label: "Mods", href: "#mods" },
    { label: "Other tools", href: "#other" },
    { label: "Contact", href: "#contact" },
  ]}>
  <div class="backdrop"></div>

  <section class="hero tf2-hero">
    <div class="container">
      <div>
        <span class="eyebrow">Team Fortress 2</span>
        <h1>Mods worth installing, <span class="soft">all in one place.</span></h1>
        <p class="lede">
          A short, hand-picked list of TF2 mods and tools: a custom UI, crosshairs, cleaner textures and viewmodels. Each
          one downloads straight from its creator.
        </p>
      </div>
    </div>
  </section>

  <section class="container store">
    <div class="store-tabs" role="tablist" aria-label="Sections">
      {
        tabs.map((tab, index) => (
          <button
            class="store-tab"
            role="tab"
            data-store-tab={tab.id}
            aria-controls={`store-${tab.id}`}
            aria-selected={index === 0 ? "true" : "false"}>
            {tab.label}
            <span>{tab.count}</span>
          </button>
        ))
      }
    </div>

    <div class="store-panel" id="store-mods" role="tabpanel" data-store-panel="mods">
      <div class="grid grid-3">
        {
          mods.map((mod) => (
            <article class="card mod">
              <div class="mod-top">
                <span class="mod-initial" aria-hidden="true">
                  {mod.name.charAt(0).toUpperCase()}
                </span>
                <div class="mod-tags">
                  {mod.private && <span class="tag tag-accent">Private</span>}
                  {mod.tags?.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              </div>
              <h3>{mod.name}</h3>
              <p>{mod.description}</p>
              <div class="mod-meta">
                <span>by {mod.creator}</span>
                <span>{mod.version}</span>
              </div>
              <a class="btn btn-primary btn-sm mod-action" href={mod.href} download rel="noopener">
                <Icon name="download" />
                Download
              </a>
            </article>
          ))
        }
      </div>
    </div>

    <div class="store-panel" id="store-other" role="tabpanel" data-store-panel="other" hidden>
      <div class="grid grid-3">
        {
          others.map((item) => (
            <article class="card mod">
              <div class="mod-top">
                <span class="mod-initial" aria-hidden="true">
                  {item.name.charAt(0).toUpperCase()}
                </span>
                <div class="mod-tags">
                  <span class:list={["tag", { "tag-discord": item.tagKind === "discord" }]}>{item.tag}</span>
                </div>
              </div>
              <h3>{item.name}</h3>
              <p>{item.description}</p>
              {item.modal ? (
                <button class="btn btn-ghost btn-sm mod-action" data-open-modal={item.modal}>
                  <Icon name="code" />
                  {item.action}
                </button>
              ) : (
                <a class="btn btn-ghost btn-sm mod-action" href={item.href} target="_blank" rel="noopener">
                  {item.action}
                  <Icon name="external" />
                </a>
              )}
            </article>
          ))
        }
      </div>
    </div>

    <div class="store-panel" id="store-contact" role="tabpanel" data-store-panel="contact" hidden>
      <div class="grid grid-3">
        {
          contacts.map((item) => (
            <article class="card mod">
              <span class="icon-chip">
                <Icon name={item.icon} />
              </span>
              <h3>{item.name}</h3>
              <p>{item.description}</p>
              <a class="btn btn-ghost btn-sm mod-action" href={item.href} target="_blank" rel="noopener">
                {item.action}
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <Modal id="customcss-modal" title="Discord CSS snippets">
    <p>
      A set of snippets that restyle the Discord client. Some are for general use, others are tuned to how I like it.
      Each folder explains its snippet.
    </p>
    <h3>My settings</h3>
    <div class="code"><code>@import url(//whyimicro.github.io/css-snippets/import.css);</code></div>
    <h3>Compact mode</h3>
    <div class="code"><code>@import url(//whyimicro.github.io/css-snippets/compactImport.css);</code></div>
  </Modal>
</Base>

<script>
  // Tabs, kept in the address bar so a link can open one: /tf2#other. Old
  // links from the previous site used #Mods, #Other and #Contact.
  function setupStore() {
    const tabs = document.querySelectorAll<HTMLButtonElement>("[data-store-tab]");
    if (!tabs.length) return;

    function show(id: string, updateHash: boolean) {
      const known = Array.from(tabs).some((tab) => tab.dataset.storeTab === id);
      if (!known) return;
      tabs.forEach((tab) => tab.setAttribute("aria-selected", String(tab.dataset.storeTab === id)));
      document.querySelectorAll<HTMLElement>("[data-store-panel]").forEach((panel) => {
        panel.hidden = panel.dataset.storePanel !== id;
      });
      if (updateHash) history.replaceState(null, "", `#${id}`);
    }

    tabs.forEach((tab) => tab.addEventListener("click", () => show(tab.dataset.storeTab!, true)));

    const fromHash = () => show(location.hash.slice(1).toLowerCase(), false);
    fromHash();
    window.addEventListener("hashchange", fromHash);
    // The header's links jump to a tab rather than scrolling to a hidden one.
    document.querySelectorAll<HTMLAnchorElement>('.nav a[href^="#"]').forEach((link) => {
      link.addEventListener("click", () => {
        show(link.hash.slice(1), true);
      });
    });
  }
  document.addEventListener("astro:page-load", setupStore);
</script>

<style>
  .tf2-hero {
    padding-bottom: 32px;
  }

  .tf2-hero .container {
    grid-template-columns: 1fr;
  }

  .tf2-hero h1 {
    max-width: 760px;
  }

  .store {
    position: relative;
    z-index: 1;
    scroll-margin-top: calc(var(--header-h) + 24px);
  }

  .store-tabs {
    display: inline-flex;
    gap: 4px;
    padding: 4px;
    border-radius: 12px;
    background: var(--surface);
    border: 1px solid var(--line);
    margin-bottom: 24px;
  }

  .store-tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 9px;
    border: 0;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }

  .store-tab span {
    font-size: 12px;
    padding: 1px 7px;
    border-radius: 999px;
    background: var(--surface-3);
    color: var(--faint);
  }

  .store-tab:hover {
    color: var(--text);
  }

  .store-tab[aria-selected="true"] {
    background: var(--surface-3);
    color: var(--text);
  }

  .store-tab[aria-selected="true"] span {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .mod {
    display: flex;
    flex-direction: column;
  }

  .mod-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }

  .mod-initial {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 19px;
    background: linear-gradient(140deg, var(--accent-soft), transparent), var(--surface-3);
    border: 1px solid var(--line-strong);
    color: var(--accent-strong);
  }

  .mod-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: flex-end;
  }

  .mod p {
    flex: 1;
  }

  .mod-meta {
    display: flex;
    gap: 14px;
    margin-top: 16px;
    font-size: 13px;
    color: var(--faint);
  }

  .mod-meta span + span::before {
    content: "·";
    margin-right: 14px;
  }

  .mod-action {
    margin-top: 18px;
    align-self: flex-start;
  }
</style>
