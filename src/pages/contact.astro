---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Email from "../components/Email.astro";
import { contacts } from "../data/contact";
---

<Base
  game="home"
  title="Contact · modworks.tf"
  description="Get in touch with modworks.tf: the Discord server, email, Cryptic's issue tracker and Steam.">
  <div class="backdrop"></div>

  <section class="contact">
    <div class="container">
      <div class="contact-head">
        <span class="eyebrow">Contact</span>
        <h1>Get in touch.</h1>
        <p class="lede">Questions about Cryptic or the TF2 mods, a bug to report, or just to say hi.</p>
      </div>

      <div class="contact-grid">
        {
          contacts.map((item) => (
            <article class="card contact-card">
              <span class="icon-chip">
                <Icon name={item.icon} />
              </span>
              <h2>{item.name}</h2>
              <p>{item.description}</p>
              {item.email ? (
                <Email class="btn btn-ghost btn-sm contact-action" />
              ) : (
                <a
                  class="btn btn-ghost btn-sm contact-action"
                  href={item.href}
                  target={item.external ? "_blank" : undefined}
                  rel={item.external ? "noopener" : undefined}>
                  {item.action}
                  {item.external && <Icon name="external" />}
                </a>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .contact {
    position: relative;
    z-index: 1;
    padding: 80px 0 96px;
  }

  .contact-head {
    max-width: 640px;
  }

  .contact h1 {
    font-size: clamp(40px, 6vw, 64px);
    font-weight: 800;
    letter-spacing: -0.035em;
    margin-top: 16px;
  }

  .contact .lede {
    margin-top: 18px;
    color: var(--muted);
    font-size: 18px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 48px;
  }

  .contact-card {
    display: flex;
    flex-direction: column;
  }

  .contact-card h2 {
    margin-top: 16px;
    font-size: 20px;
  }

  .contact-card p {
    flex: 1;
  }

  /* Global, since the email button is written out as HTML (see Email.astro). */
  .contact-card :global(.contact-action) {
    margin-top: 18px;
    align-self: flex-start;
  }

  @media (max-width: 720px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
