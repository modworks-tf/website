---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import LatestRelease from "../components/LatestRelease.astro";
import { mods } from "../data/tf2";
import { tools } from "../data/discord";
import { getReleases } from "../lib/releases";

const latest = (await getReleases(1))[0];
---

<Base game="home" title="modworks.tf · mods for Minecraft, TF2 and Discord">
  <section class="portal">
    <div class="container">
      <div class="portal-head">
        <span class="eyebrow">modworks.tf</span>
        <h1>Mods and tools, <span class="soft">made and picked by iMicro.</span></h1>
        <p class="lede">Pick one. You can switch between them from the top of any page.</p>
      </div>

      <div class="games">
        <a class="game game-tf2" href="/tf2" data-tilt="4">
          <div class="game-art chip-art" aria-hidden="true">
            {
              mods.slice(0, 4).map((mod) => (
                <div class="chip">
                  <span>{mod.name.charAt(0).toUpperCase()}</span>
                  {mod.name}
                </div>
              ))
            }
          </div>
          <div class="game-body">
            <div class="game-label">
              <Icon name="target" />Team Fortress 2
            </div>
            <h2>TF2 mods</h2>
            <p>A hand-picked set of HUDs, crosshairs, textures and tools, straight from their creators.</p>
            <span class="game-link">
              {mods.length} mods and tools
              <Icon name="arrowRight" />
            </span>
          </div>
        </a>

        <a class="game game-cryptic" href="/cryptic" data-tilt="4">
          <div class="game-art">
            <img src="/cryptic/menu.webp" alt="" width="978" height="657" loading="eager" />
          </div>
          <div class="game-body">
            <div class="game-label">
              <Icon name="cube" />Minecraft · Hypixel SkyBlock
            </div>
            <h2>Cryptic</h2>
            <p>One Fabric mod for dungeons, Floor 7, the Crystal Hollows and everything in between.</p>
            <span class="game-link">
              {latest ? <>Version <span data-latest-version>{latest.version}</span></> : "Minecraft 26.2"}
              <Icon name="arrowRight" />
            </span>
          </div>
        </a>

        <a class="game game-discord" href="/discord" data-tilt="4">
          <div class="game-art chip-art" aria-hidden="true">
            {
              tools.map((tool) => (
                <div class="chip">
                  <span>{tool.name.charAt(0).toUpperCase()}</span>
                  {tool.name}
                </div>
              ))
            }
          </div>
          <div class="game-body">
            <div class="game-label">
              <Icon name="chat" />Discord
            </div>
            <h2>Discord mods</h2>
            <p>Client mods with plugins and themes, a faster desktop app, and CSS snippets to restyle it.</p>
            <span class="game-link">
              {tools.length} mods and themes
              <Icon name="arrowRight" />
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <LatestRelease />
</Base>

<script>
  import "../scripts/tilt";
</script>

<style>
  .portal {
    position: relative;
    z-index: 1;
    padding: 80px 0 40px;
  }

  .portal-head {
    max-width: 720px;
  }

  .portal h1 {
    font-size: clamp(40px, 6vw, 64px);
    font-weight: 800;
    letter-spacing: -0.035em;
    margin-top: 16px;
  }

  .portal .soft {
    color: var(--muted);
  }

  .portal .lede {
    margin-top: 18px;
    color: var(--muted);
    font-size: 18px;
  }

  .games {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 48px;
  }

  .game {
    --game-accent: #4fae7c;
    --game-glow: rgb(54 134 91 / 34%);
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: var(--surface);
    overflow: hidden;
    text-decoration: none;
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* While it follows the pointer, it follows quickly (see tilt.ts). */
  .game.is-tilting {
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.12s ease-out;
  }

  .game-tf2 {
    --game-accent: #e8893c;
    --game-glow: rgb(232 137 60 / 28%);
  }

  .game-discord {
    --game-accent: #8b95f8;
    --game-glow: rgb(88 101 242 / 32%);
  }

  .game:hover {
    border-color: var(--game-accent);
    box-shadow: 0 30px 60px -30px var(--game-glow);
  }

  .game-art {
    position: relative;
    height: 260px;
    overflow: hidden;
    background: radial-gradient(80% 90% at 50% 100%, var(--game-glow), transparent 70%), var(--bg-raised);
    border-bottom: 1px solid var(--line);
  }

  /* The whole menu, scaled to fit the art and centred in it. */
  .game-art img {
    position: absolute;
    inset: 0;
    margin: auto;
    width: auto;
    height: auto;
    max-width: 88%;
    max-height: 86%;
    filter: drop-shadow(0 18px 30px rgb(0 0 0 / 45%));
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .game:hover .game-art img {
    transform: scale(1.03);
  }

  /* A short list of what is inside, stepped like cards fanned out. */
  .chip-art {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
    padding: 24px 32px;
  }

  .chip {
    display: flex;
    align-items: center;
    gap: 12px;
    width: min(240px, 82%);
    padding: 9px 12px;
    border-radius: 12px;
    background: var(--surface-2);
    border: 1px solid var(--line-strong);
    font-weight: 600;
    font-size: 14px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .chip:nth-child(even) {
    transform: translateX(28px);
  }

  .game:hover .chip {
    transform: translateX(6px);
  }

  .game:hover .chip:nth-child(even) {
    transform: translateX(34px);
  }

  .chip span {
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    background: color-mix(in srgb, var(--game-accent) 16%, transparent);
    color: var(--game-accent);
  }

  .game-body {
    padding: 26px 28px 28px;
  }

  .game-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--game-accent);
  }

  .game-label :global(svg) {
    width: 16px;
    height: 16px;
  }

  .game h2 {
    margin-top: 10px;
    font-size: 30px;
  }

  .game p {
    margin-top: 8px;
    color: var(--muted);
  }

  .game-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    font-weight: 600;
    font-size: 14px;
    color: var(--text);
  }

  .game-link :global(svg) {
    width: 16px;
    height: 16px;
    transition: transform 0.2s ease;
  }

  .game:hover .game-link :global(svg) {
    transform: translateX(4px);
  }

  @media (max-width: 1000px) {
    .games {
      grid-template-columns: 1fr;
    }
  }
</style>
