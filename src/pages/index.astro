---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import LatestRelease from "../components/LatestRelease.astro";
import { mods } from "../data/tf2";
import { getReleases } from "../lib/releases";

const latest = (await getReleases(1))[0];
---

<Base game="home" title="modworks.tf · mods for Minecraft and TF2">
  <div class="backdrop"></div>

  <section class="portal">
    <div class="container">
      <div class="portal-head">
        <span class="eyebrow">modworks.tf</span>
        <h1>Mods and tools, <span class="soft">made and picked by iMicro.</span></h1>
        <p class="lede">Pick a game. You can switch between them from the top of any page.</p>
      </div>

      <div class="games">
        <a class="game game-cryptic" href="/cryptic">
          <div class="game-art">
            <img src="/cryptic/menu.webp" alt="" width="980" height="660" loading="eager" />
          </div>
          <div class="game-body">
            <div class="game-label">
              <Icon name="cube" />Minecraft · Hypixel SkyBlock
            </div>
            <h2>Cryptic</h2>
            <p>One Fabric mod for dungeons, Floor 7, the Crystal Hollows and everything in between.</p>
            <span class="game-link">
              {latest ? <>Version <span data-latest-version>{latest.version}</span></> : "Minecraft 26.2"}
              <Icon name="arrowRight" />
            </span>
          </div>
        </a>

        <a class="game game-tf2" href="/tf2">
          <div class="game-art tf2-art" aria-hidden="true">
            {
              mods.slice(0, 4).map((mod) => (
                <div class="tf2-chip">
                  <span>{mod.name.charAt(0).toUpperCase()}</span>
                  {mod.name}
                </div>
              ))
            }
          </div>
          <div class="game-body">
            <div class="game-label">
              <Icon name="target" />Team Fortress 2
            </div>
            <h2>TF2 mods</h2>
            <p>A hand-picked set of HUDs, crosshairs, textures and tools, straight from their creators.</p>
            <span class="game-link">
              {mods.length} mods and tools
              <Icon name="arrowRight" />
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <LatestRelease />
</Base>

<style>
  .portal {
    position: relative;
    z-index: 1;
    padding: 80px 0 40px;
  }

  .portal-head {
    max-width: 720px;
  }

  .portal h1 {
    font-size: clamp(40px, 6vw, 64px);
    font-weight: 800;
    letter-spacing: -0.035em;
    margin-top: 16px;
  }

  .portal .soft {
    color: var(--muted);
  }

  .portal .lede {
    margin-top: 18px;
    color: var(--muted);
    font-size: 18px;
  }

  .games {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 48px;
  }

  .game {
    --game-accent: #4fae7c;
    --game-glow: rgb(54 134 91 / 34%);
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: var(--surface);
    overflow: hidden;
    text-decoration: none;
    transition:
      border-color 0.25s ease,
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .game-tf2 {
    --game-accent: #e8893c;
    --game-glow: rgb(232 137 60 / 28%);
  }

  .game:hover {
    border-color: var(--game-accent);
    transform: translateY(-3px);
    box-shadow: 0 30px 60px -30px var(--game-glow);
  }

  .game-art {
    position: relative;
    height: 260px;
    overflow: hidden;
    background: radial-gradient(80% 90% at 50% 100%, var(--game-glow), transparent 70%), var(--bg-raised);
    border-bottom: 1px solid var(--line);
  }

  .game-art img {
    position: absolute;
    left: 50%;
    top: 36px;
    width: 86%;
    transform: translateX(-50%);
    border-radius: 12px 12px 0 0;
    border: 1px solid var(--line-strong);
    box-shadow: var(--shadow);
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .game:hover .game-art img {
    transform: translateX(-50%) translateY(-8px);
  }

  .tf2-art {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-content: center;
    gap: 12px;
    padding: 32px 40px;
  }

  .tf2-chip {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px;
    border-radius: 12px;
    background: var(--surface-2);
    border: 1px solid var(--line-strong);
    font-weight: 600;
    font-size: 14px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .tf2-chip:nth-child(even) {
    transform: translateY(14px);
  }

  .game:hover .tf2-chip {
    transform: translateY(-4px);
  }

  .game:hover .tf2-chip:nth-child(even) {
    transform: translateY(8px);
  }

  .tf2-chip span {
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    background: rgb(232 137 60 / 16%);
    color: #f3a463;
  }

  .game-body {
    padding: 26px 28px 28px;
  }

  .game-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--game-accent);
  }

  .game-label :global(svg) {
    width: 16px;
    height: 16px;
  }

  .game h2 {
    margin-top: 10px;
    font-size: 30px;
  }

  .game p {
    margin-top: 8px;
    color: var(--muted);
  }

  .game-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    font-weight: 600;
    font-size: 14px;
    color: var(--text);
  }

  .game-link :global(svg) {
    width: 16px;
    height: 16px;
    transition: transform 0.2s ease;
  }

  .game:hover .game-link :global(svg) {
    transform: translateX(4px);
  }

  @media (max-width: 860px) {
    .games {
      grid-template-columns: 1fr;
    }
  }
</style>
