---
/**
 * The old address of the TF2 mods, kept so shared links still land:
 * /app#Mods goes to /tf2#mods, and /app#Contact to /contact.
 */
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content="0; url=/tf2" />
    <link rel="canonical" href="https://modworks.tf/tf2" />
    <title>Moved to /tf2 · modworks.tf</title>
    <script is:inline>
      const hash = location.hash.toLowerCase();
      location.replace(hash === "#contact" ? "/contact" : "/tf2" + hash);
    </script>
  </head>
  <body>
    <p>The TF2 mods have moved to <a href="/tf2">modworks.tf/tf2</a>.</p>
  </body>
</html>
