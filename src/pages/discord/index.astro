---
import Base from "../../layouts/Base.astro";
import LinkCard from "../../components/LinkCard.astro";
import Modal from "../../components/Modal.astro";
import Icon from "../../components/Icon.astro";
import { tools } from "../../data/discord";

const SNIPPET = "@import url(//whyimicro.github.io/css-snippets/import.css);";
---

<Base
  game="discord"
  title="Discord mods · modworks.tf"
  description="Discord client mods and themes worth trying: Vencord, BetterDiscord, OpenAsar, a set of CSS snippets and Equalizer APO.">
  <section class="hero hero-plain">
    <div class="container">
      <div>
        <span class="eyebrow">Discord</span>
        <h1>Discord, <span class="soft">the way you like it.</span></h1>
        <p class="lede">
          Client mods that add plugins and themes, a faster desktop client, the CSS snippets this site's creator uses,
          and an equalizer for everything you hear. Each one comes straight from its own site.
        </p>
      </div>
    </div>
  </section>

  <section class="container tools">
    <div class="grid grid-3">
      {tools.map((item) => <LinkCard item={item} />)}
    </div>
  </section>

  <Modal id="customcss-modal" title="Discord CSS snippets">
    <p>
      A set of snippets that restyle the Discord client. Some are for general use, others are tuned to how I like it.
      Each folder explains its snippet.
    </p>
    <h3>My settings</h3>
    <div class="code">
      <code>{SNIPPET}</code>
      <button class="btn btn-ghost btn-sm copy-button" type="button" data-copy={SNIPPET}>
        <Icon name="copy" /><span>Copy</span>
      </button>
    </div>
  </Modal>
</Base>

<script>
  // Copies the snippet, and says so on the button for a moment.
  function setupCopy() {
    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
      const label = button.querySelector("span");
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy ?? "");
          if (label) label.textContent = "Copied";
        } catch {
          // No clipboard access (an older browser, or not allowed): select the
          // snippet and try the old copy command, or leave it selected to copy by hand.
          const code = button.parentElement?.querySelector("code");
          if (code) getSelection()?.selectAllChildren(code);
          const copied = code ? document.execCommand("copy") : false;
          if (label) label.textContent = copied ? "Copied" : "Press Ctrl+C";
        }
        setTimeout(() => {
          if (label) label.textContent = "Copy";
        }, 1600);
      });
    });
  }
  document.addEventListener("astro:page-load", setupCopy);
</script>

<style>
  /* The snippet scrolls on a narrow screen; the button stays in view. */
  .code {
    overflow: hidden;
  }

  .code code {
    min-width: 0;
    overflow-x: auto;
  }

  .copy-button {
    flex: none;
  }

  .tools {
    position: relative;
    z-index: 1;
    padding-bottom: 96px;
  }
</style>
